APP_NAME="Johnny Panel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_DATABASE=/absolute/path/to/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail — set MAIL_MAILER=smtp and configure the fields below to enable
# password-reset emails. Leave as "log" to disable outbound mail.
MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Garage S3 (same region and HTTPS endpoint as your Johnny install)
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=
GARAGE_DEFAULT_REGION=johnny
GARAGE_ENDPOINT=https://storage.example.com
# Filesystem holding Garage data blocks (dashboard disk gauge)
GARAGE_DATA_DIR=/var/lib/johnny/data

# johnny CLI used for buckets, keys and permissions. Defaults match a standard install;
# set JOHNNY_CLI_SUDO_USER= (empty) to call the binary directly, e.g. in the local demo.
JOHNNY_CLI_BINARY=/usr/local/bin/johnny
JOHNNY_CLI_SUDO_USER=johnny

# API tokens (Sanctum): create under Settings in the panel, or: php artisan johnny:api-token you@example.com
